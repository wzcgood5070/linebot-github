        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ reply_token: $('Normalize Intake').item.json.reply_token, text: $('Prepare Meeting').item.json.identifier ? '已登記' + $('Prepare Meeting').item.json.title + '：' + DateTime.fromISO($('Prepare Meeting').item.json.starts_at).toFormat('yyyy/MM/dd HH:mm') + '。會議編號：' + $('Prepare Meeting').item.json.identifier + '。' : '已登記：' + DateTime.fromISO($('Prepare Meeting').item.json.starts_at).toFormat('yyyy/MM/dd HH:mm') }) }}",
        "options": {}
      },
