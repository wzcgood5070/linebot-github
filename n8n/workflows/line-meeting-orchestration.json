      "typeVersion": 2,
      "position": [
        -900,
        100
      ],
      "webhookId": "unified-meeting-intake"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nfor (const key of ['event_id', 'target_id', 'text']) {\n  if (!body[key]) throw new Error(`Missing required field: ${key}`);\n}\nreturn [{ json: {\n  event_id: String(body.event_id),\n  target_id: String(body.target_id),\n  target_type: String(body.target_type ?? body.source ?? 'external'),\n  text: String(body.text),\n  reply_token: String(body.reply_token ?? ''),\n  received_at: body.received_at ?? new Date().toISOString(),\n  source: String(body.source ?? 'external')\n} }];"
      },
      "id": "422402ff-9b21-4e39-8555-f59e4ded3304",
      "name": "Normalize Intake",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://linebot:8000/api/v1/meetings/prepare",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Core-API-Key",
              "value": "={{ $env.CORE_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event_id: $json.event_id, target_id: $json.target_id, target_type: $json.target_type, text: $json.text, received_at: $json.received_at }) }}",
        "options": {}
      },
      "id": "9da47996-aa56-4591-ae9d-19c3059dc773",
      "name": "Prepare Meeting",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -420,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return items.filter(item => item.json.accepted === true);"
      },
      "id": "120148b1-288c-4ed7-a937-b15f0049ed9d",
      "name": "Only Accepted Meetings",
