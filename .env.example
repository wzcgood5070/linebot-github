LINE_CHANNEL_SECRET=replace_me
LINE_CHANNEL_ACCESS_TOKEN=replace_me
APP_TIMEZONE=Asia/Taipei
DB_PATH=./data/meetings.db
POLL_SECONDS=10
UPLOAD_LEAD_MINUTES=10

# python：沿用舊版內建排程；n8n：由 n8n Workflow 編排與等待
ORCHESTRATOR=n8n
N8N_INTAKE_URL=http://n8n:5678/webhook/line-meeting-intake
CORE_API_KEY=replace_with_a_long_random_value
N8N_ENCRYPTION_KEY=replace_with_a_different_long_random_value
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678
POSTGRES_PASSWORD=replace_with_a_long_random_database_password

# Cloudflare Named Tunnel 的 Token；容器會同時啟動 tunnel 與 Bot
CLOUDFLARE_TUNNEL_TOKEN=replace_me

# local（本機測試）或 synology_browser（QuickConnect 瀏覽器自動化）
NAS_DRIVER=local
LOCAL_NAS_ROOT=./data/nas
LOCAL_PUBLIC_BASE_URL=https://files.example.com/upload

# Synology DSM File Station API
SYNOLOGY_BASE_URL=https://nas.example.com:5001
SYNOLOGY_PUBLIC_BASE_URL=https://quickconnect-id.quickconnect.to
SYNOLOGY_USERNAME=linebot-service
SYNOLOGY_PASSWORD=replace_me
SYNOLOGY_PARENT_PATH=/YOUR_SHARED_FOLDER/linebot
# 指向與 SYNOLOGY_PARENT_PATH 相同內容的唯讀掛載（容器內路徑）
SYNOLOGY_SUBMISSION_MOUNT=
BROWSER_PROFILE_PATH=./data/dsm-browser-profile
BROWSER_HEADLESS=false
# Windows 使用 chrome；Docker 使用空值（映像內附 Chromium）
BROWSER_CHANNEL=chrome

# GPT API；選擇支援圖片及 PDF 的模型
OPENAI_API_KEY=
OPENAI_PROGRESS_MODEL=

# Current limited deployment
INTERNAL_MEETING_JOBS=true
MEETING_SUBMISSION_CHECKS_ENABLED=false
